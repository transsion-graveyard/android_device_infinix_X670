# Allowed vendor props
get_prop(mtk_hal_camera, vendor_camera_prop)
get_prop(mtk_hal_camera, vendor_persist_camera_prop)
get_prop(mtk_hal_camera, vendor_mtk_camera_prop)

# Torch / LED sysfs (SAFE TYPE ONLY)
allow mtk_hal_camera sysfs_leds:file { read write open getattr };

# Allow Camera HAL to rw /dev/hardwareinfo
allow mtk_hal_camera hardwareinfo_device:chr_file rw_file_perms;

# Allow camera hal to rw /mnt/vendor/persist/camera and /data/vendor/camera
allow mtk_hal_camera persist_camera_file:dir rw_dir_perms;
allow mtk_hal_camera persist_camera_file:file create_file_perms;
allow mtk_hal_camera data_vendor_camera_file:dir rw_dir_perms;
allow mtk_hal_camera data_vendor_camera_file:file { create_file_perms rw_file_perms };

# p661n-style camera storage labels
allow mtk_hal_camera camera_persist_file:dir rw_dir_perms;
allow mtk_hal_camera camera_persist_file:file create_file_perms;
allow mtk_hal_camera vendor_camera_data_file:dir rw_dir_perms;
allow mtk_hal_camera vendor_camera_data_file:file { create_file_perms rw_file_perms };

# /data/vendor/multicam/dualcam/verify_flag.bin
allow mtk_hal_camera transsion_camera_data_file:dir { search write add_name };
allow mtk_hal_camera transsion_camera_data_file:file { read write create open };

allow mtk_hal_camera persist_data_file:dir search;
allow mtk_hal_camera camera_persist_file:dir search;
allow mtk_hal_camera camera_persist_file:file r_file_perms;
allow mtk_hal_camera vendor_camera_data_file:dir create_dir_perms;
allow mtk_hal_camera vendor_camera_data_file:file create_file_perms;

# Camera tuning and thermal access
allow mtk_hal_camera sysfs_therm:dir search;
allow mtk_hal_camera sysfs_therm:file rw_file_perms;

allow mtk_hal_camera sysfs_sub_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_wide_torch_file:file rw_file_perms;

# /data/vendor/camera_watermark/watermark.nv21
allow mtk_hal_camera vendor_watermark_data_file:dir { search write add_name };
allow mtk_hal_camera vendor_watermark_data_file:file { create read write open };

# /sys/devices/platform/odm/odm:tran_battery/tran_cam
allow mtk_hal_camera sysfs_tran_cam_file:file rw_file_perms;

allow mtk_hal_camera sysfs_dt_firmware_android:dir search;
allow mtk_hal_camera sysfs_dt_firmware_android:file r_file_perms;
allow mtk_hal_camera property_socket:sock_file write;
allow mtk_hal_camera hal_trancamserver_hwservice:hwservice_manager find;
binder_call(mtk_hal_camera, trancamserver)

allow mtk_hal_camera vendor_arcsoft_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_arcsoft_data_file:file { read write create getattr open };
allow mtk_hal_camera vendor_megvii_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_megvii_data_file:file { read write create getattr open };
allow mtk_hal_camera vendor_watermark_data_file:dir { read write open add_name search };
allow mtk_hal_camera vendor_watermark_data_file:file { read write create getattr open };

allow mtk_hal_camera system_data_file:dir search;
get_prop(mtk_hal_camera, exported_default_prop)

get_prop(mtk_hal_camera, graphics_config_writable_prop)
allow mtk_hal_camera self:process execmem;

allow mtk_hal_camera transsion_camera_data_file:dir { write search add_name };
allow mtk_hal_camera transsion_camera_data_file:file {read write create open };

set_prop(mtk_hal_camera, vendor_mtk_camera_prop)
set_prop(mtk_hal_camera, vendor_camera_prop)