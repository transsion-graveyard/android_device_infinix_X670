# Battery
genfscon sysfs /devices/platform/battery/power_supply/battery                                       u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/mt_charger/power_supply/ac                                         u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/mt_charger/power_supply/usb                                        u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/mt_charger/power_supply/charger                                    u:object_r:sysfs_batteryinfo:s0

# Devices (eMMC block queue - init writes iostats/read_ahead_kb/nr_requests)
genfscon sysfs /devices/platform/bootdevice/mmc_host/mmc0/mmc0:0001/block/mmcblk0                   u:object_r:sysfs_devices_block:s0

# Fingerprint
genfscon sysfs /devices/platform/fingerprint                                                       u:object_r:vendor_sysfs_fingerprint:s0
genfscon sysfs /devices/platform/odm/odm:fingerprint                                               u:object_r:vendor_sysfs_fingerprint:s0

# OTG
genfscon sysfs /devices/virtual/otg_ftm/otg_ftm                                                    u:object_r:sysfs_OTG_STATE_file:s0

# Gesture
genfscon proc /gesture_function                                                                    u:object_r:proc_gesture_function:s0
genfscon proc /gesture_state                                                                       u:object_r:proc_gesture_state:s0

# GPU
genfscon sysfs /devices/platform/13040000.mali/dvfs_period                                         u:object_r:vendor_sysfs_mali:s0
genfscon sysfs /devices/platform/13040000.mali/js_ctx_scheduling_mode                              u:object_r:vendor_sysfs_mali:s0
genfscon sysfs /devices/platform/13040000.mali/js_scheduling_period                                u:object_r:vendor_sysfs_mali:s0

# GPU frequency (MTK base labels /proc/gpufreqv2, real path is /proc/gpufreq)
genfscon proc /gpufreq                                                                              u:object_r:proc_gpufreqv2:s0

# Wakeup
genfscon sysfs /devices/platform/1000d000.pwrap/1000d000.pwrap:mt6358-pmic/mt635x-auxadc/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/1000d000.pwrap/1000d000.pwrap:mt6358-pmic/mt6358-rtc/wakeup       u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/11016000.i2c5/i2c-5/5-0053/wakeup                                 u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/mt_charger/wakeup                                                 u:object_r:sysfs_wakeup:s0

# Memory
genfscon proc /sys/vm/lowmem_reserve_ratio                                                         u:object_r:proc_watermark_boost_factor:s0
genfscon proc /sys/vm/min_free_kbytes                                                              u:object_r:proc_watermark_boost_factor:s0

# Torch
genfscon sysfs /devices/virtual/sub_torch/sub_torch/sub_torch_level                                u:object_r:sysfs_sub_torch_file:s0
genfscon sysfs /devices/virtual/torch/torch/torch_level                                            u:object_r:sysfs_torch_file:s0
