#============= platform_app ==============
allow platform_app { sysfs_sub_torch_file sysfs_torch_file sysfs_wide_torch_file }:file rw_file_perms;

# 33W Fast Charging sysfs access (Settings UI reads fast charge status)
allow platform_app sysfs_pump_express:file rw_file_perms;
allow platform_app sysfs_sfc_thermal_file:file rw_file_perms;
allow platform_app sysfs_aichg_file:file rw_file_perms;
