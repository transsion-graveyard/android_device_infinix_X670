# Allow Camera HAL to rw /dev/hardwareinfo
allow mtk_hal_camera hardwareinfo_device:chr_file rw_file_perms;

# Allow camera hal to rw /mnt/vendor/persist/camera and /data/vendor/camera
allow mtk_hal_camera persist_camera_file:dir rw_dir_perms;
allow mtk_hal_camera persist_camera_file:file create_file_perms;
allow mtk_hal_camera data_vendor_camera_file:dir rw_dir_perms;
allow mtk_hal_camera data_vendor_camera_file:file { create_file_perms rw_file_perms };

# /data/vendor/multicam/dualcam/verify_flag.bin
allow mtk_hal_camera transsion_camera_data_file:dir { search write add_name };
allow mtk_hal_camera transsion_camera_data_file:file { read write create open };

# /data/vendor/camera_watermark/watermark.nv21
allow mtk_hal_camera vendor_watermark_data_file:dir { search write add_name };
allow mtk_hal_camera vendor_watermark_data_file:file { create read write open };

# /sys/devices/platform/odm/odm:tran_battery/tran_cam
allow mtk_hal_camera sysfs_tran_cam_file:file rw_file_perms;
